{
  "name": "orbit-music",
  "private": true,
  "version": "0.1.0",
  "description": "Orbit Music（环轨音乐）— 面向本地曲库的桌面播放器，支持文件夹导入、SQLite 曲库、歌词、歌单、收藏与插件扩展",
  "author": "Orbit Music contributors",
  "license": "MIT",
  "homepage": "https://github.com/JasonItem/orbit-music#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonItem/orbit-music.git"
  },
  "bugs": {
    "url": "https://github.com/JasonItem/orbit-music/issues"
  },
  "keywords": [
    "音乐播放器",
    "本地音乐",
    "electron",
    "sqlite",
    "flac",
    "歌词",
    "歌单"
  ],
  "main": "electron/main.cjs",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=true electron .",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win --x64",
    "dist:mac": "pnpm build && electron-builder --mac --x64 --arm64",
    "dist:dir": "pnpm build && electron-builder --dir"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.74.0",
    "music-metadata": "^12.7.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/adm-zip": "^0.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
